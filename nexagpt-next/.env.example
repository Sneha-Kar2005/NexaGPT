# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Local MongoDB (default install). Use a mongodb+srv:// URI for Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/nexagpt

# Optional – defaults to gemini-3.5-flash-lite (gemini-2.5-flash-lite is retired for new API keys)
GEMINI_MODEL=gemini-3.5-flash-lite

# Secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Optional – when set, people must enter this code to create an account
# INVITE_CODE=choose-a-secret-code
